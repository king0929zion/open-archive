diff --git a/.github/workflows/apply-archive-optimization-v3.yml b/.github/workflows/apply-archive-optimization-v3.yml
--- a/.github/workflows/apply-archive-optimization-v3.yml
+++ b/.github/workflows/apply-archive-optimization-v3.yml
@@ -42,6 +42,46 @@ jobs:
           channel: stable
           cache: true
 
+      - name: Configure fixed Android signing
+        shell: bash
+        env:
+          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+        run: |
+          missing=0
+          for name in ANDROID_KEYSTORE_BASE64 ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD; do
+            if [ -z "${!name:-}" ]; then
+              echo "::error::Missing GitHub Actions secret: $name"
+              missing=1
+            fi
+          done
+          if [ "$missing" -ne 0 ]; then
+            exit 1
+          fi
+
+          printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 --decode > android/app/archive-release.jks
+          cat > android/key.properties <<EOF
+          storePassword=$ANDROID_KEYSTORE_PASSWORD
+          keyPassword=$ANDROID_KEY_PASSWORD
+          keyAlias=$ANDROID_KEY_ALIAS
+          storeFile=archive-release.jks
+          EOF
+
+          EXPECTED_SHA256="82:A5:97:05:3A:0A:1A:51:45:B1:33:3A:48:A2:8A:1C:C9:31:E6:B4:F6:E3:6A:21:EB:DD:F1:9A:79:27:75:58"
+          ACTUAL_SHA256="$(keytool -list -v \
+            -keystore android/app/archive-release.jks \
+            -storepass "$ANDROID_KEYSTORE_PASSWORD" \
+            -alias "$ANDROID_KEY_ALIAS" \
+            | sed -n 's/^[[:space:]]*SHA256: //p' | head -n 1)"
+          if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
+            echo "::error::Android signing certificate fingerprint mismatch"
+            exit 1
+          fi
+
       - name: Resolve dependencies
         run: flutter pub get
 
